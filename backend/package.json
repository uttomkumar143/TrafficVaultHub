{
  "name": "@trafficvaulthub/backend",
  "version": "0.0.1",
  "private": true,
  "description": "TrafficVaultHub API — Cloudflare Workers + Hono (Phase 0 skeleton)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.1"
  }
}
